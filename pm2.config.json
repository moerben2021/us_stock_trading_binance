{
  "apps": [
    {
      "name": "us-stock-dca",
      "script": "main.py",
      "interpreter": "python",
      "cwd": "/path/to/us_stock_trading_binance",
      "instances": 1,
      "autorestart": true,
      "watch": false,
      "max_memory_restart": "500M",
      "env": {
        "PYTHONUNBUFFERED": "1"
      },
      "error_file": "logs/pm2-error.log",
      "out_file": "logs/pm2-out.log",
      "log_date_format": "YYYY-MM-DD HH:mm:ss Z"
    }
  ]
}
