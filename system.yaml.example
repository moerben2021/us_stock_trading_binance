# System Configuration
# US Stock DCA Framework - Production Configuration

system:
  timezone: "America/New_York"
  log_level: "DEBUG"
  proxy:
    enabled: true  # 代理开关：本地测试时改为 true，服务器环境改为 false
    http: "http://127.0.0.1:7990"  # 代理地址
    https: "http://127.0.0.1:7990"  # 代理地址

scheduler:
  check_interval: 60
  manual_trade_scan_interval: 300

database:
  path: "./data/trading.db"

cache:
  realtime_price_ttl: 30
  history_data_clear_time: "02:00"

retry:
  api_call:
    max_attempts: 3
    interval_seconds: 5
    backoff: 1.5
  data_fetch:
    max_attempts: 3
    interval_seconds: 10
    backoff: 1.5
  trade_execution:
    max_attempts: 2
    interval_seconds: 3
    backoff: 1.2

notifications:
  admin_webhook: "https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=YOUR_ADMIN_WEBHOOK_KEY"  # 系统级通知 webhook（日报/周报/月报）
  summaries:
    daily:
      enabled: true
      time: "16:30"  # 美东时间下午 4:30（收盘后）
    weekly:
      enabled: true
      day: "Friday"
      time: "16:30"
    monthly:
      enabled: true
      day: 28
      time: "16:30"

snapshots:
  after_trade: true
  daily_close: true

balance_check:
  insufficient_action: "partial"  # 可选: partial（部分成交）, skip（跳过）

