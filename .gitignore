# 敏感信息
secrets/
!secrets/.gitkeep

# 配置文件（包含 webhook 等敏感信息）
configs/accounts/*.yaml
!configs/accounts/*.yaml.example
system.yaml

# 数据库
data/*.db
data/*.db-journal

# 日志
logs/*.log
logs/pm2-*.log

# 文档输出（草稿、帖子等临时内容）
docs/outputs/

# 工作日志（个人记录，不提交）
docs/work_logs/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
dist/
*.egg-info/

# IDE
.vscode/
.idea/
*.swp
*.swo

# 操作系统
.DS_Store
Thumbs.db
